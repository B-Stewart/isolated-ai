#!/usr/bin/env bash

set -Eeuo pipefail

usage() {
  printf 'Usage: isoai [code [-- <command> [args...]] | -- <command> [args...]]\n' >&2
}

launch_code=false
command_mode=false
if [[ $# -gt 0 ]]; then
  case "$1" in
    --)
      command_mode=true
      shift
      ;;
    code)
      launch_code=true
      shift
      if [[ $# -gt 0 && $1 != -- ]]; then
        usage
        printf 'isoai: code may only be followed by -- <command> [args...]\n' >&2
        exit 2
      fi
      if [[ $# -gt 0 ]]; then
        command_mode=true
        shift
      fi
      ;;
    *)
      usage
      printf 'isoai: unsupported arguments\n' >&2
      exit 2
      ;;
  esac
fi

if [[ "$command_mode" == true && $# -eq 0 ]]; then
  usage
  printf 'isoai: -- must be followed by a command\n' >&2
  exit 2
fi

if [[ "$launch_code" == true ]]; then
  if ! command -v code >/dev/null 2>&1; then
    printf 'isoai: code is not installed or not on PATH\n' >&2
    exit 1
  fi
  if ! command -v xxd >/dev/null 2>&1; then
    printf 'isoai: xxd is not installed or not on PATH\n' >&2
    exit 1
  fi
fi

if ! command -v docker >/dev/null 2>&1; then
  printf 'isoai: docker is not installed or not on PATH\n' >&2
  exit 1
fi
if ! docker info >/dev/null 2>&1; then
  printf 'isoai: docker is not available (is the daemon running?)\n' >&2
  exit 1
fi

workspace=$(pwd -P)
home=${HOME:?isoai: HOME is not set}

# This is the initializeCommand from .devcontainer/devcontainer.json, run on
# the host before Docker sees any of the bind mounts.
mkdir -p \
  "$home/.agents" \
  "$home/.claude" \
  "$home/.config/opencode" \
  "$home/.local/share/opencode" \
  "$home/.config/rtk" \
  "$home/.local/share/rtk" \
  "$home/.config/configstore" \
  "$home/.cache/firebase" \
  "$home/.config/gh" \
  "$home/.codegraph"
touch "$home/.claude.json"

if command -v sha256sum >/dev/null 2>&1; then
  workspace_hash=$(printf '%s' "$workspace" | sha256sum | cut -c1-12)
else
  workspace_hash=$(printf '%s' "$workspace" | shasum -a 256 | cut -c1-12)
fi
workspace_base=${workspace##*/}
workspace_base=${workspace_base:-root}
workspace_base=${workspace_base//[^[:alnum:]_.-]/-}
container_name="isolated-ai-${workspace_base}-${workspace_hash}"

image='braydens/agentic-base:latest'
mount_args=(
  --mount "type=bind,src=$workspace,dst=$workspace,consistency=cached"
  --mount "type=bind,src=$home/.agents,dst=/home/agent/.agents"
  --mount "type=bind,src=$home/.claude,dst=/home/agent/.claude"
  --mount "type=bind,src=$home/.claude.json,dst=/home/agent/.claude.json"
  --mount "type=bind,src=$home/.config/opencode,dst=/home/agent/.config/opencode"
  --mount "type=bind,src=$home/.local/share/opencode,dst=/home/agent/.local/share/opencode"
  --mount "type=bind,src=$home/.config/rtk,dst=/home/agent/.config/rtk"
  --mount "type=bind,src=$home/.local/share/rtk,dst=/home/agent/.local/share/rtk"
  --mount "type=bind,src=$home/.config/configstore,dst=/home/agent/.config/configstore"
  --mount "type=bind,src=$home/.cache/firebase,dst=/home/agent/.cache/firebase"
  --mount "type=bind,src=$home/.config/gh,dst=/home/agent/.config/gh"
  --mount "type=bind,src=$home/.codegraph,dst=/home/agent/.codegraph"
  --mount type=volume,src=isolated-pw-browsers,dst=/home/agent/.cache/ms-playwright
  --mount type=bind,src=/var/run/docker.sock,dst=/var/run/docker.sock
)

run_args=(
  '--label=com.docker.compose.project=agentic-isolated-ai'
  '--cap-drop=ALL'
  '--security-opt=no-new-privileges:true'
  '--pids-limit=4096'
  '--tmpfs=/tmp:rw,nosuid,exec'
)

created=false
if docker container inspect "$container_name" >/dev/null 2>&1; then
  if [[ "$(docker inspect -f '{{.State.Running}}' "$container_name")" != true ]]; then
    docker start "$container_name" >/dev/null
  fi
else
  docker run -d \
    --name "$container_name" \
    --user agent \
    --workdir "$workspace" \
    --env "COMPOSE_PROJECT_NAME=$workspace_base" \
    "${run_args[@]}" \
    "${mount_args[@]}" \
    "$image" \
    tail -f /dev/null >/dev/null
  created=true
fi

if [[ "$created" == true ]]; then
  docker exec -u agent -w "$workspace" "$container_name" \
    sh -c 'if [ -f package.json ] && grep -q '"'"'"playwright"'"'"' package.json; then npx --yes playwright install chromium; fi'
fi

if [[ "$launch_code" == true ]]; then
  container_payload=$(printf '%s' "{\"containerName\":\"/$container_name\"}" | xxd -p -c 9999)
  code --folder-uri "vscode-remote://attached-container+${container_payload}${workspace}"
fi

if [[ $# -gt 0 ]]; then
  exec_args=(-i)
  if [[ -t 0 && -t 1 ]]; then
    exec_args+=(-t)
  fi
  exec docker exec "${exec_args[@]}" -u agent -w "$workspace" "$container_name" "$@"
fi

printf 'Container: %s\n' "$container_name"
printf 'VS Code: attach with “Dev Containers: Attach to Running Container…” and select %s\n' "$container_name"
