#!/usr/bin/env bash

set -Eeuo pipefail

usage() {
  printf 'Usage: isoai [help|--help|-h]\n'
  printf '       isoai [--code|-c] [--image gd|-i gd] [-- <command> [args...]]\n'
  printf '       isoai [--code|-c] [--image=gd|-i=gd] [-- <command> [args...]]\n'
  printf '\n'
  printf 'Launches an isolated-ai container (default image: braydens/agentic-base:latest).\n'
  printf 'The only supported image selector is gd (braydens/agentic-gamedev:latest).\n'
  printf '%s\n' '--code opens VS Code; a command after -- runs in the container.'
}

launch_code=false
command_mode=false
image_selector=''
while [[ $# -gt 0 ]]; do
  case "$1" in
    help|--help|-h)
      usage
      exit 0
      ;;
    --)
      command_mode=true
      shift
      break
      ;;
    --code|-c)
      launch_code=true
      shift
      ;;
    --image=*|-i=*)
      image_selector=${1#*=}
      if [[ -z $image_selector ]]; then
        usage >&2
        printf 'isoai: image selector must not be empty\n' >&2
        exit 2
      fi
      if [[ $image_selector != gd ]]; then
        usage >&2
        printf 'isoai: unsupported image selector: %s\n' "$image_selector" >&2
        exit 2
      fi
      shift
      ;;
    --image|-i)
      if [[ $# -lt 2 ]]; then
        usage >&2
        printf 'isoai: %s requires an image selector\n' "$1" >&2
        exit 2
      fi
      image_selector=$2
      if [[ -z $image_selector ]]; then
        usage >&2
        printf 'isoai: image selector must not be empty\n' >&2
        exit 2
      fi
      if [[ $image_selector != gd ]]; then
        usage >&2
        printf 'isoai: unsupported image selector: %s\n' "$image_selector" >&2
        exit 2
      fi
      shift 2
      ;;
    *)
      usage >&2
      printf 'isoai: unsupported argument: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

if [[ "$command_mode" == true && $# -eq 0 ]]; then
  usage >&2
  printf 'isoai: -- must be followed by a command\n' >&2
  exit 2
fi

if [[ "$launch_code" == true ]]; then
  if ! command -v code >/dev/null 2>&1; then
    printf 'isoai: code is not installed or not on PATH\n' >&2
    exit 1
  fi
  if ! command -v xxd >/dev/null 2>&1; then
    printf 'isoai: xxd is not installed or not on PATH\n' >&2
    exit 1
  fi
fi

if ! command -v docker >/dev/null 2>&1; then
  printf 'isoai: docker is not installed or not on PATH\n' >&2
  exit 1
fi
if ! docker info >/dev/null 2>&1; then
  printf 'isoai: docker is not available (is the daemon running?)\n' >&2
  exit 1
fi

workspace=$(pwd -P)
home=${HOME:?isoai: HOME is not set}

# This is the initializeCommand from .devcontainer/devcontainer.json, run on
# the host before Docker sees any of the bind mounts.
mkdir -p \
  "$home/.agents" \
  "$home/.claude" \
  "$home/.config/opencode" \
  "$home/.local/share/opencode" \
  "$home/.config/rtk" \
  "$home/.local/share/rtk" \
  "$home/.config/configstore" \
  "$home/.cache/firebase" \
  "$home/.config/gh" \
  "$home/.codegraph"
touch "$home/.claude.json"
touch "$home/.gitconfig"

if command -v sha256sum >/dev/null 2>&1; then
  workspace_hash=$(printf '%s' "$workspace" | sha256sum | cut -c1-12)
else
  workspace_hash=$(printf '%s' "$workspace" | shasum -a 256 | cut -c1-12)
fi
workspace_base=${workspace##*/}
workspace_base=${workspace_base:-root}
workspace_base=${workspace_base//[^[:alnum:]_.-]/-}
container_name="isolated-ai-${workspace_base}-${workspace_hash}"

image='braydens/agentic-base:latest'
if [[ $image_selector == gd ]]; then
  image='braydens/agentic-gamedev:latest'
  container_name+="-gd"
fi

ssh_agent_dir="$home/.local/state/isoai/ssh/$container_name"
ssh_agent_path=/run/isoai/ssh/agent.sock
ssh_upstream=''
if ! mkdir -p "$ssh_agent_dir"; then
  printf 'isoai: could not create the private SSH relay directory; refusing to start without a safe mount source.\n' >&2
  exit 1
fi
if [[ -L "$ssh_agent_dir" || ! -d "$ssh_agent_dir" || ! -O "$ssh_agent_dir" ]]; then
  printf 'isoai: private SSH relay directory must be a real directory owned by the current user; refusing to start.\n' >&2
  exit 1
fi
if ! chmod 700 "$ssh_agent_dir"; then
  printf 'isoai: could not set private SSH relay directory permissions; refusing to start.\n' >&2
  exit 1
fi
if [[ -n ${SSH_AUTH_SOCK:-} ]]; then
  if [[ -S $SSH_AUTH_SOCK ]]; then
    ssh_upstream=$SSH_AUTH_SOCK
  else
    printf 'isoai: SSH_AUTH_SOCK is not an available socket; forwarding could not be refreshed and an existing relay may remain active.\n' >&2
  fi
else
  printf 'isoai: no host SSH agent socket is available; forwarding could not be refreshed and an existing relay may remain active.\n' >&2
fi
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
ssh_helper="$script_dir/isoai-ssh-agent.py"
host_uid=$(id -u)
if [[ $host_uid != 1000 ]]; then
  printf 'isoai: host UID is not 1000; the container agent cannot access the private SSH relay without unsafe permissions. Forwarding could not be refreshed and an existing relay may remain active.\n' >&2
elif ! command -v python3 >/dev/null 2>&1; then
  printf 'isoai: python3 is unavailable; forwarding could not be refreshed and an existing relay may remain active.\n' >&2
elif [[ ! -f $ssh_helper ]]; then
  printf 'isoai: SSH relay helper is missing next to isoai; forwarding could not be refreshed and an existing relay may remain active.\n' >&2
elif [[ -d "$ssh_agent_dir" ]] && ! python3 "$ssh_helper" ensure "$ssh_agent_dir" "$ssh_upstream"; then
  printf 'isoai: SSH relay setup failed; forwarding could not be refreshed and an existing relay may remain active.\n' >&2
fi

mount_args=(
  --mount "type=bind,src=$workspace,dst=$workspace,consistency=cached"
  --mount "type=bind,src=$home/.agents,dst=/home/agent/.agents"
  --mount "type=bind,src=$home/.claude,dst=/home/agent/.claude"
  --mount "type=bind,src=$home/.claude.json,dst=/home/agent/.claude.json"
  --mount "type=bind,src=$home/.config/opencode,dst=/home/agent/.config/opencode"
  --mount "type=bind,src=$home/.local/share/opencode,dst=/home/agent/.local/share/opencode"
  --mount "type=bind,src=$home/.config/rtk,dst=/home/agent/.config/rtk"
  --mount "type=bind,src=$home/.local/share/rtk,dst=/home/agent/.local/share/rtk"
  --mount "type=bind,src=$home/.config/configstore,dst=/home/agent/.config/configstore"
  --mount "type=bind,src=$home/.cache/firebase,dst=/home/agent/.cache/firebase"
  --mount "type=bind,src=$home/.config/gh,dst=/home/agent/.config/gh"
  --mount "type=bind,src=$home/.gitconfig,dst=/home/agent/.gitconfig"
  --mount "type=bind,src=$home/.codegraph,dst=/home/agent/.codegraph"
  --mount type=volume,src=isolated-pw-browsers,dst=/home/agent/.cache/ms-playwright
  --mount type=bind,src=/var/run/docker.sock,dst=/var/run/docker.sock
)

run_args=(
  '--label=com.docker.compose.project=agentic-isolated-ai'
  '--cap-drop=ALL'
  '--security-opt=no-new-privileges:true'
  '--pids-limit=4096'
  '--tmpfs=/tmp:rw,nosuid,exec'
  --env "SSH_AUTH_SOCK=$ssh_agent_path"
)

mount_args+=(--mount "type=bind,src=$ssh_agent_dir,dst=/run/isoai/ssh,readonly")

created=false
create_container() {
  docker run -d \
    --name "$container_name" \
    --user agent \
    --workdir "$workspace" \
    --env "COMPOSE_PROJECT_NAME=$workspace_base" \
    "${run_args[@]}" \
    "${mount_args[@]}" \
    "$image" \
    tail -f /dev/null >/dev/null
  created=true
}

if docker container inspect "$container_name" >/dev/null 2>&1; then
  if [[ "$(docker inspect -f '{{.State.Running}}' "$container_name")" != true ]]; then
    if start_error=$(docker start "$container_name" 2>&1 >/dev/null); then
      :
    else
      start_status=$?
      printf '%s\n' "$start_error" >&2
      lower_start_error=${start_error,,}
      if [[ "$lower_start_error" == *mount* && "$start_error" == */ssh-agent* ]]; then
        printf 'isoai: this existing container has a legacy /ssh-agent mount and cannot be retrofitted in place. It was left unchanged; snapshot and preserve its writable layer before any manual migration or recreation.\n' >&2
        exit "$start_status"
      else
        printf 'isoai: docker start failed for an unrelated error; the container was left unchanged. Resolve the error and retry.\n' >&2
        exit "$start_status"
      fi
    fi
  fi
else
  create_container
fi

if [[ "$created" == true ]]; then
  docker exec -u agent -w "$workspace" "$container_name" \
    sh -c 'if [ -f package.json ] && grep -q '"'"'"playwright"'"'"' package.json; then npx --yes playwright install chromium; fi'
fi

if [[ "$launch_code" == true ]]; then
  container_payload=$(printf '%s' "{\"containerName\":\"/$container_name\"}" | xxd -p -c 9999)
  code --folder-uri "vscode-remote://attached-container+${container_payload}${workspace}"
fi

if [[ $# -gt 0 ]]; then
  exec_args=(-i)
  if [[ -t 0 && -t 1 ]]; then
    exec_args+=(-t)
  fi
  exec docker exec "${exec_args[@]}" -u agent -w "$workspace" "$container_name" "$@"
fi

printf 'Container: %s\n' "$container_name"
printf 'VS Code: attach with “Dev Containers: Attach to Running Container…” and select %s\n' "$container_name"
